# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Injected by CI / deploy pipeline (falls back to "dev" when unset)
GIT_SHA=

# Database connection (placeholder — schema lands in BOO-P0-5)
DATABASE_URL=postgresql://localhost:5432/korovan

# DeepSeek API key — server-side only, never expose to the client (BOO-P0-3)
DEEPSEEK_API_KEY=

# DeepSeek base URL (no trailing /v1 — the adapter appends /v1/chat/completions internally)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
